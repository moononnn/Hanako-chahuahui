{
  "schema": 1,
  "project": {
    "id": "chahuahui",
    "name": "茶话会",
    "kind": "app",
    "version": "0.17.0",
    "repoUrl": "moononnn/Hanako-chahuahui"
  },
  "publisher": "moononnn & 小花",
  "source": {
    "roots": [
      "."
    ]
  },
  "checks": {
    "testCommands": [],
    "deferredTo": "existing-ci + local precise verify"
  },
  "package": {
    "topLevel": "chahuahui",
    "entry": "index.js",
    "include": [],
    "excludeDirs": [
      "tests",
      "node_modules",
      ".git",
      ".github",
      "_backups",
      ".cloud-build",
      ".cache",
      "out",
      ".tmp",
      "attachments",
      "docs"
    ],
    "excludeFiles": [
      "AGENTS.md",
      "PENDING_CHANGES.md",
      "PUBLISHING.md",
      "PROJECT_LOG.md",
      "TESTING.md",
      "PROMPT_OPTIMIZATION.md",
      "lib/reply-rule-probe.js",
      "tests/reply-rule-probe.test.js",
      "tests/taste-probe-context.test.js",
      "lib/local-dev.js",
      "lib/dev-video-diagnose.js",
      "lib/dev-thread-range.js",
      "lib/dev-thread-range-store.js",
      "lib/dev-thread-range-backup.js",
      "ui/local-dev.js",
      "tests/dev-thread-range.test.js",
      "tests/dev-thread-range-store.test.js",
      "tests/dev-thread-range-backup.test.js",
      "DEV_THREAD_RANGE.md",
      ".gitignore",
      ".gitattributes",
      ".installed-by.json",
      "data.json",
      "preferences.json",
      "probe-result.json"
    ],
    "excludeGlobs": [
      "DESIGN-*.md",
      "PLAN-*.md",
      "EXPERIMENT-*.md",
      "TEST-REFACTOR-PLAN.md",
      "*.log",
      "*.tmp",
      "analysis-*.json",
      "taste-*.json",
      "*.corrupt-*",
      ".corrupt-*"
    ]
  },
  "devOnly": {
    "targets": [
      "index.js",
      "lib/store.js"
    ],
    "startMark": "// __CHAHUAHUI_DEV_ONLY__",
    "endMark": "// __CHAHUAHUI_DEV_ONLY_END__",
    "residue": [
      "DEV_TOOLS",
      "内测",
      "/probe",
      "/notify/test",
      "/proactive/tick",
      "tasteProbe",
      "analyzePersonalityOnce",
      "startPersonalityAnalysis",
      "chahuahui_ping",
      "chahuahui_taste_probe",
      "chahuahui_tool_probe",
      "localDevHooks",
      "probe/local-status",
      "local-dev.js",
      "devRemoveThreadRange",
      "devSetRolledWatermark",
      "chahuahui_thread_range_admin"
    ],
    "replacements": [
      {
        "file": "manifest.json",
        "from": "    \"app/resources.write\",",
        "to": ""
      }
    ]
  },
  "privacy": {
    "redlineSource": "local-only（云端不持有词表；本机用 projects/<id>.json 的 redline 扫）",
    "textExtensions": [
      ".js",
      ".mjs",
      ".cjs",
      ".json",
      ".md",
      ".html",
      ".css",
      ".txt",
      ".yml",
      ".yaml",
      ".ps1"
    ],
    "allowedNames": [
      "小花",
      "moononnn",
      "Hanako",
      "Moonon"
    ]
  },
  "resources": {
    "manifestFile": "manifest.json",
    "bases": [
      "",
      "ui/"
    ],
    "pointers": [
      "icon",
      "contributes.cards[].face.image",
      "contributes.cards[].pageIcon",
      "contributes.cards[].route"
    ]
  },
  "output": {
    "archiveBaseName": "app-chahuahui-{version}",
    "zipExtension": ".zip"
  },
  "toolchain": {
    "packScript": "scripts/extension-pack.mjs",
    "pin": {
      "channel": "beta",
      "channelManifest": "https://dl.openhanako.com/channels/beta.json",
      "version": "1.5.118-beta",
      "platform": "win32-x64",
      "file": "server-1.5.118-beta-win32-x64.tar.gz",
      "sha256": "4348a3a88efb93130b7de0c2375777288796faad189959c605b56aca6ea8b358",
      "size": 276858819,
      "mirrors": [
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-47",
        "https://dl.openhanako.com",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-40",
        "https://github.com/liliMozi/openhanako/releases/download/train-beta-37"
      ]
    }
  }
}
