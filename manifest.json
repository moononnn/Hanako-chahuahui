{
  "manifestVersion": 2,
  "id": "chahuahui",
  "name": "茶话会",
  "version": "0.7.501",
  "entry": "index.js",
  "description": "茶话会：像 QQ 一样跟伙伴闲聊。主对话框面对面谈正事，这里围炉聊八卦。",
  "icon": "assets/icon.png",
  "minAppVersion": "0.1020.0",
  "capabilities": [
    "app/models.infer",
    "app/agents.read",
    "app/resources.read",
    "app/services.provide",
    "app/services.call",
    "app/public-data.read"
  ],
  "network": {
    "allowedHosts": [
      "www.bing.com",
      "top.baidu.com",
      "www.toutiao.com",
      "api.minimaxi.com",
      "api.xiaomimimo.com",
      "*.aliyuncs.com"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 8000,
    "maxResponseBytes": 1048576
  },
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "茶话会",
        "description": "好友列表与聊天窗口。",
        "face": {
          "image": "assets/icon.png"
        },
        "pageIcon": "assets/nav-icon.png",
        "route": "/panel.html",
        "realization": "page",
        "siteNavEntry": true,
        "detached": {
          "route": "/panel.html"
        },
        "detachedDefaultSize": {
          "width": 1080,
          "height": 800
        },
        "cardForm": "flush",
        "titlebar": "solid"
      },
      {
        "id": "canvas",
        "title": "茶话会·并排",
        "description": "跟主对话框并排用的茶话会小卡，同一份聊天账。",
        "face": {
          "image": "assets/icon.png"
        },
        "route": "/panel.html",
        "cardForm": "edge-to-edge"
      }
    ]
  }
}
