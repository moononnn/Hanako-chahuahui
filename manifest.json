{
  "manifestVersion": 2,
  "id": "chahuahui",
  "name": "茶话会",
  "version": "0.12.0",
  "entry": "index.js",
  "description": "像聊天软件一样和 Hana 里的伙伴唠嗑，ta 也会根据自己的兴趣爱好主动找你聊天搭话。搭配「表情包」可以互相斗图，搭配「拾光记」不仅可以感知天气、提醒待办，还能在使用「专注」功能时，陪你沉浸式专注。ta 现在还会自己去刷 B 站，碰上感兴趣的视频就分享给你。",
  "icon": "assets/icon.png",
  "minAppVersion": "0.1020.0",
  "capabilities": [
    "app/models.infer",
    "app/usage.read",
    "app/process.spawn",
    "app/tools.expose-to-model",
    "app/agents.read",
    "app/resources.read",
    "app/resources.write",
    "app/services.provide",
    "app/services.call",
    "app/public-data.read",
    "app/events.emit",
    "app/ui.open-external",
    "app/ui.clipboard-write"
  ],
  "network": {
    "allowedHosts": [
      "api.bilibili.com",
      "passport.bilibili.com",
      "passport.biligame.com",
      "aisubtitle.hdslb.com",
      "*.hdslb.com",
      "*.bilivideo.com",
      "comment.bilibili.com",
      "www.bing.com",
      "api.tavily.com",
      "api.deepseek.com",
      "google.serper.dev",
      "api.search.brave.com",
      "api.anysearch.com",
      "top.baidu.com",
      "www.toutiao.com",
      "api.minimaxi.com",
      "api.xiaomimimo.com",
      "*.aliyuncs.com"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "defaultTimeoutMs": 8000,
    "maxResponseBytes": 20971520
  },
  "contributes": {
    "cards": [
      {
        "id": "panel",
        "title": "茶话会",
        "description": "好友列表与聊天窗口。",
        "face": {
          "image": "assets/icon.png"
        },
        "pageIcon": "assets/nav-icon-adaptive.svg",
        "route": "/panel.html",
        "realization": "page",
        "siteNavEntry": true,
        "detached": {
          "route": "/panel.html"
        },
        "detachedDefaultSize": {
          "width": 1080,
          "height": 800
        },
        "cardForm": "flush",
        "titlebar": "solid"
      },
      {
        "id": "canvas",
        "title": "茶话会·小窗",
        "description": "跟主对话框并排用的茶话会小卡，同一份聊天账。",
        "face": {
          "image": "assets/icon.png"
        },
        "route": "/panel.html",
        "cardForm": "edge-to-edge"
      }
    ]
  }
}
